{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/best-free-camscanner-alternative.html",
      "destination": "/blog/best-free-camscanner-alternatives.html",
      "permanent": true
    },
    {
      "source": "/blog/best-free-camscanner-alternative",
      "destination": "/blog/best-free-camscanner-alternatives.html",
      "permanent": true
    },
    {
      "source": "/blog/docs_man-security-redaction-best-practices.html",
      "destination": "/blog/document-security-redaction-best-practices.html",
      "permanent": true
    },
    {
      "source": "/blog/how-to-remove-sensitive-info-from-tax-forms-single-page.html",
      "destination": "/blog/document-security-redaction-best-practices.html",
      "permanent": true
    },
    {
      "source": "/blog/cv-resume-maker-guide.html",
      "destination": "/blog/index.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(assets|css|js|icons|lang)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; script-src 'self' https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://*.googletagmanager.com data: blob:; worker-src 'self' blob:; object-src 'none';"
        }
      ]
    }
  ]
}
